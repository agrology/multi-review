#!/usr/bin/env bash
# pre-push — refuse to push a branch that has not raised the plugin version.
#
# The documented gate (§11) already includes multi-review-version-check.sh, but a documented step
# is only as binding as the person remembering it. This repo has no CI, so a local hook is the one
# place the rule can actually bite: a merge performed on GitHub runs nothing of ours, which makes
# the feature-branch push the last moment a missing bump is still cheap to fix.
#
# Deliberately narrow: it runs the VERSION check only, not the whole suite. The suite is a
# pre-review gate that takes over a minute; a push happens many times a branch. Guarding the one
# thing that is silently forgotten — and forgotten precisely because nothing downstream complains
# — is the whole point.
#
# Bypass with `git push --no-verify` (git's own escape hatch; no second one is added here).
set -uo pipefail

ZERO='0000000000000000000000000000000000000000'
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
check="${root}/scripts/multi-review-version-check.sh"
[[ -x "$check" ]] || exit 0            # not this repo, or a checkout without the script

# stdin: <local-ref> <local-sha> <remote-ref> <remote-sha>, one line per ref being pushed.
# A deletion has an all-zero LOCAL sha and pushes no content, so it has nothing to bump.
pushing=0
while read -r _lref lsha _rref _rsha; do
  [[ -n "${lsha:-}" && "$lsha" != "$ZERO" ]] && pushing=1
done
(( pushing )) || exit 0

"$check" && exit 0

echo "pre-push: refusing to push — see above." >&2
echo "pre-push: bump .claude-plugin/plugin.json, or use 'git push --no-verify' for a WIP branch." >&2
exit 1
